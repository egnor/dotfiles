#!/bin/sh
# Managed by pyinfra. Source: dotfiles/deadman/files/netdata-deadman
#
# Dead-man's switch for the netdata parent. Everything else in this repo
# alerts *from* egnor-2020, so nothing here can report egnor-2020's own
# death: if the host is down, the monitoring parent, the alert evaluator,
# and several of the monitored sites all go with it, silently.
#
# So: ping an external healthchecks.io check on a timer. Stop pinging and
# healthchecks.io notices and posts to the same ntfy topic netdata uses.
# The ping is conditional on netdata actually answering, so this covers
# netdata-dead and netdata-wedged in addition to host-down.
#
# HC_PING_URL is the check's UUID URL; it's a bearer-ish secret (anyone
# holding it can forge pings), so it lives out-of-band in
# /etc/default/netdata-deadman rather than in the repo. If it's missing we
# exit non-zero on purpose: the failed unit trips netdata's systemdunits
# alert, so a misconfigured deadman is itself noticed.

set -eu

if [ -r /etc/default/netdata-deadman ]; then
    . /etc/default/netdata-deadman
fi

: "${HC_PING_URL:?unset; put HC_PING_URL=https://hc-ping.com/<uuid> in /etc/default/netdata-deadman}"
: "${NETDATA_URL:=http://127.0.0.1:19998/api/v1/info}"

if curl -fsS --max-time 10 -o /dev/null "$NETDATA_URL"; then
    ping_url="$HC_PING_URL"
else
    echo "netdata did not answer $NETDATA_URL; reporting failure" >&2
    ping_url="$HC_PING_URL/fail"
fi

# --retry covers a transient blip so a single lost ping doesn't burn into
# the grace period. Failing to deliver the ping is worth a non-zero exit
# (it lands in the journal), but the netdata-down case is not: healthchecks
# already has that alert, and a failed unit here would just be an echo.
curl -fsS --max-time 20 --retry 3 --retry-delay 5 -o /dev/null "$ping_url"
