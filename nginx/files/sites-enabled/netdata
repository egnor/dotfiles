# Managed by pyinfra. Source: dotfiles/nginx/files/sites-enabled/netdata

# netdata.eacs.io — reverse proxy to the local Netdata dashboard
# (Netdata listens on 127.0.0.1:19998; *:19999 stays streaming-only for children.)
# Cert is the shared `competent.services` SAN cert (covers eacs.io et al).
server {
  server_name netdata.eacs.io;
  include /etc/nginx/snippets/tls-competent.conf;

  auth_basic "Netdata";
  auth_basic_user_file /etc/nginx/htpasswd-netdata;

  # Alert deep links. alarm-notify.sh builds every sender's link as
  # ${NETDATA_REGISTRY_URL}/registry-alert-redirect.html?host=...&transition_id=...
  # and health_alarm_notify.conf points NETDATA_REGISTRY_URL here, so turn
  # that into the agent's own alert view (the path the real registry page
  # would redirect to once it resolved an agent URL, which it never can for
  # us). `return` runs before auth, so this answers 302 unauthenticated;
  # the target is still behind auth_basic.
  location = /registry-alert-redirect.html {
    return 302 /spaces/$arg_host/rooms/local/alerts/$arg_transition_id?$args;
  }

  location / {
    proxy_pass http://127.0.0.1:19998;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_pass_request_headers on;
  }
}
